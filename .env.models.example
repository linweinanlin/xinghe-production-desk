# Local-only model credentials for Xinghe Commercial Director.
# This file is ignored by source control and is never returned to the browser.
DEEPSEEK_API_KEY=
ARK_API_KEY=
# 智谱开放平台（bigmodel.cn）。图片 CogView 与视频 CogVideoX 共用同一把 Key，填一次两通道都能用。
# 把下一行等号后面换成你的 Key（形如 xxxxxxxx.yyyyyyyy，纯英文数字，不要带中文和引号）。
ZHIPU_API_KEY=
# 阿里云百炼（DashScope）。万相 wan2.7 负责出图（支持 9 张参考图锁角色），wan2.7-i2v 负责出片。
# Key 形如 sk-xxxxxxxxxxxxxxxxxxxx，在 bailian.console.aliyun.com 右上角「API-KEY」里创建。
DASHSCOPE_API_KEY=
# 腾讯云混元生视频（hunyuan-video）。到 CAM -> API 密钥管理 新建密钥后，把下面两行等号后面换成真实值。
# SecretId 形如 AKID + 32 位，共 36 位；SecretKey 共 32 位（只显示一次，务必当场存好）。
# 纯英文字母数字，不要带引号、不要带中文前缀。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
